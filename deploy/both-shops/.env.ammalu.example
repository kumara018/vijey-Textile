# Copy to .env on the VM and fill in. NEVER commit the filled-in .env.
#
# startup_checks.py refuses to boot if the starred ones are missing or still
# placeholders, so a mistake here fails loudly at deploy rather than quietly in
# a customer's account.

# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/dbname?sslmode=require
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
FRONTEND_URL=https://www.ammalutex.com

# ── Email: Brevo is the primary sender, Gmail SMTP the fallback ─────────────
BREVO_API_KEY=
SMTP_EMAIL=
SMTP_PASSWORD=
SUPPORT_EMAIL=

# ── Payments ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Media ───────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Shipping ────────────────────────────────────────────────────────────────
DELHIVERY_API_TOKEN=
DELHIVERY_MODE=
DELHIVERY_PICKUP_NAME=

# ── SMS / WhatsApp: LEAVE BLANK ─────────────────────────────────────────────
# Carriers charge per message, so these can never be free. The helpers no-op
# when unset and every OTP still goes out by email. See FREE_STACK.md.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
