# Copy to .env on the VM and fill in. NEVER commit the filled-in .env.
#
# startup_checks.py refuses to boot if the starred ones are missing or still
# placeholders, so a mistake here fails loudly at deploy rather than quietly in
# a customer's account.

# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/dbname?sslmode=require
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
FRONTEND_URL=https://www.ammalutex.com

# ── Email: Brevo is the primary sender, Gmail SMTP the fallback ─────────────
BREVO_API_KEY=
SMTP_EMAIL=
SMTP_PASSWORD=
SUPPORT_EMAIL=

# ── Payments ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Media ───────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Shipping ────────────────────────────────────────────────────────────────
DELHIVERY_API_TOKEN=
DELHIVERY_MODE=
DELHIVERY_PICKUP_NAME=

# ── SMS / WhatsApp: LEAVE BLANK ─────────────────────────────────────────────
# Carriers charge per message, so these can never be free. The helpers no-op
# when unset and every OTP still goes out by email. See FREE_STACK.md.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# ── Delivery pickup (where Delhivery collects) ────────────────────────────────
# The pickup name must match the warehouse in the Delhivery dashboard exactly.
DELHIVERY_RETURN_PIN=638102
DELHIVERY_RETURN_CITY=Gangapuram
DELHIVERY_RETURN_STATE=Tamil Nadu
DELHIVERY_RETURN_PHONE=
DELHIVERY_RETURN_NAME=
DELHIVERY_RETURN_ADDRESS=

# ── Web push (the free, unlimited notification channel) ───────────────────────
# Generate with:  docker compose exec api python -m push
# Each shop needs its OWN pair. Replacing them invalidates every subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# ── Messaging ─────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
TWILIO_WHATSAPP_FROM=

# ── Optional. Every one has a working default; set only to override ──────────
#
# Listed so nothing the code reads is a surprise later. Checked against the
# source: these are the complete set, and nothing outside this file is read.

ENABLE_API_DOCS=false      # true exposes /docs and /openapi.json publicly
ADMIN_PHONE=               # where admin alerts go, if you want them
LOG_LEVEL=INFO             # DEBUG when chasing something
UPLOAD_DIR=uploads         # only used if Cloudinary is unset

ACCESS_TOKEN_EXPIRE_MINUTES=129600   # 90 days, matching the frontend cookie
ALGORITHM=HS256
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# SENDGRID_API_KEY=        # a second fallback after Brevo. Unused if Brevo is set.
# SMTP_HOST=               # only for a non-Render host; Render blocks SMTP entirely
# SMTP_PORT=587            # 465 selects implicit TLS, 587 STARTTLS

# NOT USED. Shiprocket was replaced by Delhivery; the code still reads these so
# an old deployment keeps working, and they can stay empty.
# SHIPROCKET_EMAIL=
# SHIPROCKET_PASSWORD=
# SHIPROCKET_PICKUP_LOCATION=

# SET BY THE PLATFORM, never by you: PORT and RENDER. Docker sets PORT in the
# compose file; RENDER exists only on Render and is how the app knows SMTP is
# blocked there.

# THE RECOVERY HATCH. Set ADMIN_PASSWORD_RESET=true and the NEXT BOOT re-syncs
# the admin password to ADMIN_PASSWORD, once, loudly. Then unset it. Leaving it
# on would roll the password back on every restart, which is how an owner loses
# a password they deliberately changed.
# ADMIN_PASSWORD_RESET=
