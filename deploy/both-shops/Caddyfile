# One Caddy, two shops. A separate certificate is obtained and renewed for each
# hostname automatically; they are independent.
#
# Create BOTH A records pointing at this machine's public IP before starting,
# or the certificate for whichever name does not resolve will fail to issue.
#
# SYNTAX NOTE, learned the hard way. Caddy requires an opening brace to be the
# LAST thing on its line — `header { -Server }` written on one line is a parse
# error ("Unexpected next token after '{' on same line"), and a Caddyfile that
# does not parse means Caddy never starts at all. It then restarts in a loop
# and the symptom looks exactly like a certificate that will not issue, which
# sends you off checking DNS for an hour. Keep every block opened and closed on
# its own line.

api.vijeytextile.com {
	reverse_proxy vijey-api:8000

	# Compress responses. The product list is JSON and compresses well, which
	# matters on the mobile connections most customers are using.
	encode zstd gzip

	# HSTS IS SET HERE, because Caddy does NOT add it by default. This comment
	# used to say it did, and the API went out with no Strict-Transport-Security
	# header at all (found in the October 2026 test pass). The rest of the
	# security headers come from the app; this one belongs to the TLS layer.
	header {
		-Server
		-Via
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output stdout
		format console
	}
}

api.ammalutex.com {
	reverse_proxy ammalu-api:8000

	encode zstd gzip

	header {
		-Server
		-Via
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output stdout
		format console
	}
}
