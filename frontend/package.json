{
  "name": "vijey-textile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:tailwind && npm run check:hero && npm run check:frames && npm run check:visual && next build",
    "start": "next start",
    "lint": "npm run check:tailwind && next lint",
    "check:tailwind": "node scripts/check-tailwind-config.js",
    "check:hero": "node scripts/check-hero-assets.js",
    "check:frames": "node scripts/check-frame-content.mjs public/hero --sample 3",
    "verify": "npm run check:tailwind && npm run check:hero && npm run check:frames && npm run check:visual && tsc --noEmit",
    "check:visual": "node scripts/visual-regression.mjs",
    "shoot": "node scripts/shoot-page.mjs",
    "measure": "node scripts/measure-routes.mjs",
    "drills": "node scripts/failure-drills.mjs",
    "a11y": "node scripts/a11y-pass.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "check:hero-matrix": "node scripts/check-hero-matrix.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.8.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.5",
    "@react-three/rapier": "^2.2.0",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.12.98",
    "@tanstack/react-query": "^5.101.4",
    "@types/three": "^0.185.4",
    "axios": "^1.6.8",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "fuse.js": "^7.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.31.0",
    "next": "^16.2.6",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-hot-toast": "^2.4.1",
    "three": "^0.185.1",
    "tone": "^15.1.22",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "^15.3.2",
    "postcss": "^8",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22 <25"
  }
