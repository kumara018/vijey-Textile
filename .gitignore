# Dependencies
node_modules/
frontend/node_modules/

# Python
__pycache__/
*.pyc
*.pyo
backend/__pycache__/
backend/venv/

# Environment files (keep out of git)
backend/.env
frontend/.env.local
frontend/.env

# Database
backend/*.db
backend/ammalu_tex.db
# SQLite's write-ahead log and shared-memory files. These were tracked, and
# that is why `git checkout` failed with "local changes would be overwritten":
# the running backend — and OneDrive — hold an OS lock on them, so git can
# neither unlink nor rewrite them, and every branch switch aborted. They are
# transient journals for a LOCAL dev database. Nothing should ever have been
# reading them from the repository.
backend/*.db-wal
backend/*.db-shm
backend/*.db-journal

# Uploads
backend/uploads/

# Build output
frontend/.next/
frontend/out/
frontend/tsconfig.tsbuildinfo

# Local tooling (dev-server launch config, agent scratch)
.claude/

# Misc
.DS_Store
*.log

# Offline hero render intermediates — 500MB+ of lossless PNG.
# Only the encoded tier ladder under public/hero/<tier>/ is shipped.
frontend/public/hero/raw/
